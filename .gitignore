# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
# NOTE: notebooks/*.ipynb IS committed for submission (with output cells preserved
# for grading). The Jupytext `.py` files are the source-of-truth template;
# `.ipynb` is the student's executed deliverable.

# Lab artifacts (regenerated on every run; do not commit)
data/pref/
data/eval_prompts.json
adapters/sft-mini/
adapters/dpo/
adapters/orpo/
gguf/
*.gguf
runs/
wandb/

# Keep small, reproducible submission evidence in Git. Adapter weight tensors
# remain ignored (Option C is valid), but the configs/metrics and prepared
# preference parquet let a reviewer run the gatekeeper from a fresh clone.
!data/pref/
data/pref/*
!data/pref/train.parquet
!data/pref/eval.parquet

!adapters/sft-mini/
adapters/sft-mini/*
!adapters/sft-mini/adapter_config.json

!adapters/dpo/
adapters/dpo/*
!adapters/dpo/adapter_config.json
!adapters/dpo/dpo_metrics.json
!adapters/dpo/dpo_training_config.json
!adapters/dpo/dpo_training_log.jsonl

# HuggingFace cache (Colab + local — model weights are huge)
.cache/
hf_cache/

# Env / secrets
.env
.env.local
*.token

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
